<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="StudentMaster.master.cs" Inherits="IGNITE.Student.StudentMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IGNITE — Student Portal</title>

    <!-- Google Fonts: Plus Jakarta Sans for crisp modern typography matching design -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- IGNITE Master Stylesheet -->
    <link href="<%= ResolveUrl("~/Content/student-master.css") %>" rel="stylesheet" type="text/css" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true" />

        <div class="ignite-app-layout">
            <!-- Left Sidebar Navigation -->
            <aside class="ignite-sidebar">
                <!-- Brand / Logo -->
                <a href="<%= ResolveUrl("~/Student/Dashboard.aspx") %>" class="sidebar-brand" title="IGNITE Student Portal">
                    <svg class="brand-flame-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2C10.5 4.5 10 6.5 10 8.5C10 10.5 11 11.5 11 13C11 14 10 15 9 15C8 15 7 14 7 12.5C7 10 5.5 8.5 4.5 8C4.5 12 6.5 15.5 9 18C11.5 20.5 14.5 21.5 17 20C19.5 18.5 20.5 15.5 20 13C19.5 10.5 18 9 17 8C17 9.5 16 10.5 15 10.5C14 10.5 13.5 9.5 13.5 8C13.5 5.5 15 3.5 16 2.5C14.5 2 13 2 12 2Z" />
                    </svg>
                    <span class="brand-title">IGNITE</span>
                </a>

                <!-- Navigation Modules -->
                <nav class="sidebar-nav">
                    <a id="navDashboard" runat="server" href="~/Student/Dashboard.aspx" class="nav-item">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                        </svg>
                        <span>Dashboard</span>
                    </a>

                    <a id="navHabits" runat="server" href="~/Student/Habits.aspx" class="nav-item">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                            <path d="M9 16l2 2 4-4"></path>
                        </svg>
                        <span>Habits</span>
                    </a>

                    <a id="navTasks" runat="server" href="~/Student/Tasks.aspx" class="nav-item">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                            <line x1="8" y1="7" x2="16" y2="7"></line>
                            <line x1="8" y1="11" x2="14" y2="11"></line>
                        </svg>
                        <span>Tasks</span>
                    </a>

                    <a id="navGoals" runat="server" href="~/Student/Goals.aspx" class="nav-item">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                        <span>Goals</span>
                    </a>

                    <a id="navChallenges" runat="server" href="~/Student/Challenges.aspx" class="nav-item">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
                            <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
                            <path d="M4 22h16"></path>
                            <path d="M10 14.66V17c0 .55-.45 1-1 1H8c-.55 0-1 .45-1 1v1h10v-1c0-.55-.45-1-1-1h-1c-.55 0-1-.45-1-1v-2.34"></path>
                            <path d="M6 4h12v5c0 3.31-2.69 6-6 6s-6-2.69-6-6V4z"></path>
                        </svg>
                        <span>Challenges</span>
                    </a>

                    <a id="navCalendar" runat="server" href="~/Student/Calendar.aspx" class="nav-item">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                            <circle cx="8" cy="14" r="1"></circle>
                            <circle cx="12" cy="14" r="1"></circle>
                            <circle cx="16" cy="14" r="1"></circle>
                            <circle cx="8" cy="18" r="1"></circle>
                            <circle cx="12" cy="18" r="1"></circle>
                        </svg>
                        <span>Calendar</span>
                    </a>

                    <a id="navProgress" runat="server" href="~/Student/Journal.aspx" class="nav-item">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                            <line x1="8" y1="7" x2="16" y2="7"></line>
                            <line x1="8" y1="11" x2="14" y2="11"></line>
                        </svg>
                        <span>Journal &amp; Notes</span>
                    </a>
                </nav>

                <!-- Bottom Section: Settings & User Profile Card -->
                <div class="sidebar-footer">
                    <a id="navSettings" runat="server" href="~/Student/Profile.aspx" class="settings-pill-btn">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </svg>
                        <span>Settings</span>
                    </a>

                    <!-- User Profile Card -->
                    <div class="user-profile-card" onclick="window.location.href='<%= ResolveUrl("~/Student/Profile.aspx") %>';" style="cursor: pointer;" title="View Profile">
                        <div class="user-avatar-ring">
                            <span class="avatar-ring-inner"></span>
                        </div>
                        <div class="user-card-info">
                            <div class="user-card-name">
                                <asp:Literal ID="litStudentName" runat="server">Alex Mercer</asp:Literal>
                            </div>
                            <div class="user-card-role">
                                <asp:Literal ID="litStudentLevelTitle" runat="server">Level 12 Scholar</asp:Literal>
                            </div>
                        </div>
                        <asp:LinkButton ID="btnLogout" runat="server" OnClick="btnLogout_Click" OnClientClick="event.stopPropagation();" CssClass="card-logout-btn" title="Sign Out" CausesValidation="false">
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                            </svg>
                        </asp:LinkButton>
                    </div>
                </div>
            </aside>

            <!-- Main Workspace Layout -->
            <div class="ignite-main-area">
                <!-- Top Header Bar -->
                <header class="topbar-header">
                    <!-- Left: Title & Streak Badge -->
                    <div class="topbar-left">
                        <h1 class="page-title">
                            <asp:ContentPlaceHolder ID="PageTitleContent" runat="server">Dashboard</asp:ContentPlaceHolder>
                        </h1>

                        <div class="streak-pill-badge" title="Current Daily Streak">
                            <svg class="flame-streak-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 2C10.5 4.5 10 6.5 10 8.5C10 10.5 11 11.5 11 13C11 14 10 15 9 15C8 15 7 14 7 12.5C7 10 5.5 8.5 4.5 8C4.5 12 6.5 15.5 9 18C11.5 20.5 14.5 21.5 17 20C19.5 18.5 20.5 15.5 20 13C19.5 10.5 18 9 17 8C17 9.5 16 10.5 15 10.5C14 10.5 13.5 9.5 13.5 8C13.5 5.5 15 3.5 16 2.5C14.5 2 13 2 12 2Z" />
                            </svg>
                            <span><asp:Literal ID="litStreakDays" runat="server">15</asp:Literal> DAY STREAK</span>
                        </div>
                    </div>

                    <!-- Right: XP Meter, Notification Bell, Search -->
                    <div class="topbar-right">
                        <!-- Level & XP Widget -->
                        <div class="xp-container" onclick="window.location.href='<%= ResolveUrl("~/Student/XP.aspx") %>';" style="cursor: pointer;" title="View XP & Level Details">
                            <div class="xp-labels">
                                <span class="lvl-label">LVL <asp:Literal ID="litLevelNum" runat="server">12</asp:Literal></span>
                                <span class="xp-label"><asp:Literal ID="litXPText" runat="server">4,500 / 6,000 XP</asp:Literal></span>
                            </div>
                            <div class="xp-track">
                                <div id="xpProgressBar" runat="server" class="xp-fill" style="width: 75%;"></div>
                            </div>
                        </div>

                        <!-- Notification Bell Box -->
                        <a href="<%= ResolveUrl("~/Student/Dashboard.aspx#notifications") %>" class="icon-box-btn" title="Notifications">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                            </svg>
                            <span id="pnlNotifDot" runat="server" class="notification-red-dot"></span>
                        </a>

                        <!-- Search Bar -->
                        <div class="search-input-wrapper">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <input type="text" placeholder="Search..." class="search-input" />
                        </div>
                    </div>
                </header>

                <!-- Page Content Body -->
                <main class="page-content-canvas">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </main>
            </div>
        </div>

        <script src="<%= ResolveUrl("~/Scripts/student-master.js") %>" type="text/javascript"></script>

        <asp:ContentPlaceHolder ID="ScriptsContent" runat="server">
        </asp:ContentPlaceHolder>
    </form>
</body>
</html>
