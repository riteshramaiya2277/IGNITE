<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="IGNITEConnection" 
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=IGNITEDb;Integrated Security=True;MultipleActiveResultSets=True" 
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />

    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login.aspx" timeout="2880" defaultUrl="~/Student/Dashboard.aspx" name=".IGNITEAUTH" />
    </authentication>

  </system.web>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <defaultDocument>
      <files>
        <clear />
        <add value="Student/Dashboard.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
